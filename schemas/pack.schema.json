{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabin.dev/schemas/pack.schema.json",
  "title": "Agent contracts pack registry",
  "description": "Groups the bundle's roles, skills and Claude workflow programs into installable packs. A global pack may be installed into the operator's home directory and is part of the default selection; a project pack may only be installed into a project destination and is never selected by default.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packs"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pack"}
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "scope", "roles", "skills", "workflows"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "enum": ["global", "project"]},
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "skills": {"$ref": "#/$defs/member_list"},
        "workflows": {"$ref": "#/$defs/member_list"}
      }
    },
    "member_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

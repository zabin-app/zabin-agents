{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zabin.dev/schemas/recovery-checkpoint.schema.json",
  "title": "Zabin recovery checkpoint",
  "description": "A minimal, non-authoritative recovery snapshot for state that cannot be reconstructed from Zabin alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "key",
    "phase_base",
    "payload_references",
    "task_verdict",
    "gate_snapshots",
    "completion_summary_evidence",
    "action_item_resolutions",
    "commit_mappings",
    "retired_fields"
  ],
  "properties": {
    "$schema": {
      "const": "https://zabin.dev/schemas/recovery-checkpoint.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "key": {
      "$ref": "#/$defs/checkpointKey"
    },
    "phase_base": {
      "$ref": "#/$defs/gitSha"
    },
    "payload_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payloadReference"
      }
    },
    "task_verdict": {
      "$ref": "#/$defs/taskVerdict"
    },
    "gate_snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gateSnapshot"
      }
    },
    "completion_summary_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "action_item_resolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionItemResolution"
      }
    },
    "commit_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commitMapping"
      }
    },
    "retired_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retiredField"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "checkpointKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "plan_id",
        "phase_id",
        "wave_id",
        "task_id",
        "sha"
      ],
      "properties": {
        "project_id": {"$ref": "#/$defs/identifier"},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "phase_id": {"$ref": "#/$defs/identifier"},
        "wave_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "sha": {"$ref": "#/$defs/gitSha"}
      }
    },
    "payloadReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "content_sha256", "full_payload"],
      "properties": {
        "kind": {"enum": ["research", "review"]},
        "reference": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "full_payload": {"const": true}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "content_sha256"],
      "properties": {
        "reference": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "content_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "taskVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "verdict", "evidence"],
      "properties": {
        "round": {"type": "integer", "minimum": 0},
        "verdict": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64,
          "pattern": ".*\\S.*"
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceReference"}
        }
      }
    },
    "gateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "gate", "status", "snapshot", "captured_at"],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"},
        "gate": {"$ref": "#/$defs/identifier"},
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": ".*\\S.*"
        },
        "snapshot": {"$ref": "#/$defs/jsonObjectValue"},
        "captured_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "actionItemResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_item_id",
        "status",
        "resolution",
        "evidence",
        "captured_at"
      ],
      "properties": {
        "action_item_id": {"$ref": "#/$defs/identifier"},
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": ".*\\S.*"
        },
        "resolution": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceReference"}
        },
        "captured_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "commitMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "recorded_sha", "merged_sha"],
      "properties": {
        "source_sha": {"$ref": "#/$defs/gitSha"},
        "recorded_sha": {"$ref": "#/$defs/gitSha"},
        "merged_sha": {
          "oneOf": [
            {"$ref": "#/$defs/gitSha"},
            {"type": "null"}
          ]
        }
      }
    },
    "retiredField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reason", "retired_in_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "reason": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "retired_in_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "replacement": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "jsonObjectValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entries"],
      "properties": {
        "type": {"const": "object"},
        "entries": {
          "type": "array",
          "description": "Entries use unique property names in ascending Unicode code point order; runtime validation enforces the canonical order that JSON Schema cannot express.",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/jsonObjectEntry"}
        }
      }
    },
    "jsonObjectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "boolean"},
            "value": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "number"},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "string"},
            "value": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {"const": "array"},
            "items": {
              "type": "array",
              "items": {"$ref": "#/$defs/jsonValue"}
            }
          }
        },
        {"$ref": "#/$defs/jsonObjectValue"}
      ]
    }
  }
}
